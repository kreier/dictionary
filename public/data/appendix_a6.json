    "A6-B": {
      "title": "Übersicht: Propheten und Könige von Juda und Israel (Teil 2)",
      "url": "https://www.jw.org/de/bibliothek/bibel/nwt/anhang-a/koenige-israel/",
      "items": [
        {
          "type": "h2",
          "text": "Könige des Südreichs (Fortsetzung)"
        },
        {
          "type": "h3",
          "text": "777 v. u. Z."
        },
        {
          "type": "p",
          "text": "Jotham: 16 Jahre"
        },
        {
          "type": "h3",
          "text": "762"
        },
        {
          "type": "p",
          "text": "Ahas: 16 Jahre"
        },
        {
          "type": "h3",
          "text": "746"
        },
        {
          "type": "p",
          "text": "Hiskia: 29 Jahre"
        },
        {
          "type": "h3",
          "text": "716"
        },
        {
          "type": "p",
          "text": "Manasse: 55 Jahre"
        },
        {
          "type": "h3",
          "text": "661"
        },
        {
          "type": "p",
          "text": "Amon: 2 Jahre"
        },
        {
          "type": "h3",
          "text": "659"
        },
        {
          "type": "p",
          "text": "Josia: 31 Jahre"
        },
        {
          "type": "h3",
          "text": "628"
        },
        {
          "type": "p",
          "text": "Jehoahas: 3 Monate"
        },
        {
          "type": "p",
          "text": "Jojakim: 11 Jahre"
        },
        {
          "type": "h3",
          "text": "618"
        },
        {
          "type": "p",
          "text": "Jojachin: 3 Monate, 10 Tage"
        },
        {
          "type": "h3",
          "text": "617"
        },
        {
          "type": "p",
          "text": "Zedekia: 11 Jahre"
        },
        {
          "type": "h3",
          "text": "607"
        },
        {
          "type": "p",
          "text": "Zerstörung Jerusalems und des Tempels durch die Babylonier unter Nebukadnezar. Zedekia, der letzte irdische König in der Linie Davids, wird gestürzt"
        },
        {
          "type": "h2",
          "text": "Könige des Nordreichs (Fortsetzung)"
        },
        {
          "type": "h3",
          "text": "um 803 v. u. Z."
        },
        {
          "type": "p",
          "text": "Sacharja: berichtet wird nur von 6 Monaten"
        },
        {
          "type": "p",
          "text": "Sacharjas Regierung begann in gewissem Sinn, lag jedoch offensichtlich erst um 792 fest in seinen Händen"
        },
        {
          "type": "h3",
          "text": "um 791"
        },
        {
          "type": "p",
          "text": "Schallum: 1 Monat"
        },
        {
          "type": "p",
          "text": "Menahem: 10 Jahre"
        },
        {
          "type": "h3",
          "text": "um 780"
        },
        {
          "type": "p",
          "text": "Pekachja: 2 Jahre"
        },
        {
          "type": "h3",
          "text": "um 778"
        },
        {
          "type": "p",
          "text": "Pekach: 20 Jahre"
        },
        {
          "type": "h3",
          "text": "um 758"
        },
        {
          "type": "p",
          "text": "Hoschea: 9 Jahre (ab etwa 748)"
        },
        {
          "type": "h3",
          "text": "um 748"
        },
        {
          "type": "p",
          "text": "Um 748 konnte Hoschea wohl seine Herrschaft festigen oder bekam Unterstützung vom assyrischen König Tiglath-Pileser III."
        },
        {
          "type": "h3",
          "text": "740"
        },
        {
          "type": "p",
          "text": "Assyrien nimmt Samaria ein und unterwirft Israel; Ende des Nordreichs Israel"
        },
        {
